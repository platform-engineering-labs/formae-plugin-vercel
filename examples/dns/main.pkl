/*
 * Domains and DNS.
 *
 * Attaches a domain to a project and manages records on it. The apex domain
 * must already be on your Vercel account — this example manages records on it,
 * it does not buy or transfer it.
 *
 * Adding a custom domain to a project needs a paid plan; on Hobby the API
 * answers `custom_domain_needs_upgrade`.
 *
 *   formae apply --mode reconcile --watch examples/dns/main.pkl
 */
amends "@formae/forma.pkl"

import "@formae/formae.pkl"
import "@vercel/core/vercel.pkl"

// The apex domain you already own on Vercel.
local apex = "example.com"

local site = new vercel.Project {
  label = "dns-demo-site"
  name = "dns-demo-site"
  framework = "nextjs"
}

forma {
  new formae.Stack {
    label = "dns-demo"
    description = "Domain and DNS records for one project"
  }

  new formae.Target {
    label = "vercel"
    config = new vercel.Config {}
  }

  site

  // Serve the project at www.example.com.
  new vercel.ProjectDomain {
    label = "www-domain"
    projectId = site.res.id
    name = "www.\(apex)"
  }

  // Send the apex to www with a permanent redirect.
  new vercel.ProjectDomain {
    label = "apex-domain"
    projectId = site.res.id
    name = apex
    redirect = "www.\(apex)"
    redirectStatusCode = 308
  }

  // A plain A record. `recordType` rather than `type`: formae.Resource
  // reserves `type`.
  new vercel.DNSRecord {
    label = "api-a-record"
    domain = apex
    name = "api"
    recordType = "A"
    value = "203.0.113.10"
    ttl = 3600
    comment = "Managed by formae"
  }

  // Mail exchanger. MX uses mxPriority alongside the value.
  new vercel.DNSRecord {
    label = "mx-record"
    domain = apex
    name = ""            // empty string means the apex itself
    recordType = "MX"
    value = "mail.\(apex)"
    mxPriority = 10
    ttl = 3600
  }

  // Domain verification / SPF style TXT record.
  new vercel.DNSRecord {
    label = "spf-record"
    domain = apex
    name = ""
    recordType = "TXT"
    value = "v=spf1 include:_spf.google.com ~all"
    ttl = 3600
  }
}
