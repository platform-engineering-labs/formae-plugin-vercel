/*
 * Observability drains.
 *
 * Log, trace and audit-log drains are all the same endpoint — POST /v1/drains —
 * differing only in the `schemas` map and the delivery transport. This plugin
 * therefore has one type, VERCEL::Drains::Drain, and you pick the shape.
 *
 *   formae apply --mode reconcile --watch examples/drains/main.pkl
 */
amends "@formae/forma.pkl"

import "@formae/formae.pkl"
import "@vercel/core/vercel.pkl"
import "@vercel/core/drains.pkl"

forma {
  new formae.Stack {
    label = "observability"
    description = "Log and trace drains"
  }

  new formae.Target {
    label = "vercel"
    config = new vercel.Config {}
  }

  // A log drain: schemas {log}, delivered over HTTP.
  new drains.Drain {
    label = "log-drain"
    name = "ship-logs-to-collector"
    projects = "all"
    schemas = new Mapping {
      ["log"] = new drains.DrainSchema { version = "v1" }
    }
    delivery = new drains.DrainHTTPDelivery {
      endpoint = "https://logs.example.com/ingest"
      encoding = "ndjson"
      compression = "gzip"
      headers = new Mapping {
        ["x-source"] = "vercel"
      }
    }
  }

  // A trace drain: schemas {trace}, delivered over OTLP/HTTP.
  new drains.Drain {
    label = "trace-drain"
    name = "ship-traces-to-collector"
    projects = "all"
    schemas = new Mapping {
      ["trace"] = new drains.DrainSchema { version = "v1" }
    }
    delivery = new drains.DrainOTLPDelivery {
      endpoint = new drains.DrainOTLPEndpoint {
        traces = "https://otlp.example.com/v1/traces"
      }
      encoding = "proto"
    }
  }
}
