/// Vercel Drains.
///
/// A Drain forwards observability data off the platform. One endpoint —
/// `POST /v1/drains` — serves every kind: what a drain carries is decided by
/// the `schemas` map (`log`, `trace`, `audit_log`, …) and the matching
/// `delivery` transport.
///
/// The official Terraform provider splits this into three resources —
/// `vercel_log_drain`, `vercel_trace_drain` and `vercel_audit_log_drain` — but
/// all three of its clients call `POST /v1/drains`. They are one resource here.
///
/// Endpoint reference:
/// <https://vercel.com/docs/rest-api/drains/create-a-new-drain>
module drains

import "@formae/formae.pkl"

// =============================================================================
// Delivery
// =============================================================================

/// OTLP/HTTP endpoint set, used by `DrainOTLPDelivery`.
///
/// The API nests the URL one level deeper for OTLP than for the other
/// transports: `delivery.endpoint.traces` rather than a plain string.
@formae.SubResourceHint {}
class DrainOTLPEndpoint extends formae.SubResource {
    /// Full OTLP/HTTP traces endpoint URL, commonly ending in `/v1/traces`.
    @formae.FieldHint { requiredOnCreate = true }
    traces: String
}

/// Where and how a drain ships its data.
///
/// The API accepts three shapes here, keyed on `type`, each declaring
/// `additionalProperties: false` — a key belonging to one shape is rejected
/// outright by the others. They are therefore three classes rather than one
/// with optional fields: an unset optional `Mapping` still renders as `{}`,
/// which would put a `headers` key into an `s3` body that has no such field.
abstract class DrainDelivery extends formae.SubResource {
    /// Transport to deliver over. Sent to the API as `type`, which
    /// `formae.Resource` reserves further up the tree; the name is kept
    /// distinct here so the two never collide.
    @formae.FieldHint { requiredOnCreate = true; outputField = "type" }
    transport: "http"|"otlphttp"|"s3"
}

/// Deliver over plain HTTP POST. Backs log drains and HTTP audit-log drains.
@formae.SubResourceHint {}
class DrainHTTPDelivery extends DrainDelivery {
    transport = "http"

    /// HTTPS endpoint that receives the events.
    @formae.FieldHint { requiredOnCreate = true }
    endpoint: String

    /// Wire format of the delivered payload.
    @formae.FieldHint { requiredOnCreate = true }
    encoding: "json"|"ndjson"

    /// Headers sent with every delivery request. The API requires the key —
    /// leave the mapping empty rather than omitting it.
    @formae.FieldHint {}
    headers: Mapping<String, String>?

    /// Compression applied to the request body.
    @formae.FieldHint {}
    compression: ("gzip"|"none")?

    /// Secret used to sign delivered events. Vercel generates one when this is
    /// left unset, so it is excluded from drift detection.
    @formae.FieldHint { writeOnly = true }
    secret: String?
}

/// Deliver over OTLP/HTTP. Backs trace drains.
@formae.SubResourceHint {}
class DrainOTLPDelivery extends DrainDelivery {
    transport = "otlphttp"

    /// OTLP/HTTP endpoint set.
    @formae.FieldHint { requiredOnCreate = true }
    endpoint: DrainOTLPEndpoint

    /// OTLP wire format.
    @formae.FieldHint { requiredOnCreate = true }
    encoding: "json"|"proto"

    /// Headers sent with every delivery request. The API requires the key —
    /// leave the mapping empty rather than omitting it.
    @formae.FieldHint {}
    headers: Mapping<String, String>?

    /// Secret used to sign delivered events. Vercel generates one when this is
    /// left unset, so it is excluded from drift detection.
    @formae.FieldHint { writeOnly = true }
    secret: String?
}

/// Write events as objects into an S3 bucket Vercel assumes a role into.
/// Backs S3 audit-log drains.
@formae.SubResourceHint {}
class DrainS3Delivery extends DrainDelivery {
    transport = "s3"

    /// Bucket and optional prefix the objects are written to.
    @formae.FieldHint { requiredOnCreate = true }
    endpoint: String

    /// Wire format of each written object.
    @formae.FieldHint { requiredOnCreate = true }
    encoding: "json"|"ndjson"

    /// Compression applied to written objects. The API accepts only `none`
    /// here, and requires the key.
    @formae.FieldHint { requiredOnCreate = true }
    compression: "none"

    /// Layout of the objects written to the bucket.
    @formae.FieldHint { requiredOnCreate = true }
    fileStructure: "hive"

    /// ARN of the AWS IAM role Vercel assumes to write objects.
    @formae.FieldHint { requiredOnCreate = true }
    roleArn: String

    /// AWS region holding the bucket.
    @formae.FieldHint { requiredOnCreate = true }
    region: String

    /// Server-side encryption applied to written objects.
    @formae.FieldHint {}
    serverSideEncryption: ("AES256"|"aws:kms"|"aws:kms:dsse")?

    /// Canned ACL applied to written objects.
    @formae.FieldHint {}
    objectAcl: ("private"|"bucket-owner-read"|"bucket-owner-full-control")?
}

// =============================================================================
// Schemas
// =============================================================================

/// Version of one data schema carried by a drain.
@formae.SubResourceHint {}
class DrainSchema extends formae.SubResource {
    /// Schema version, e.g. `v1`.
    @formae.FieldHint { requiredOnCreate = true }
    version: String
}

// =============================================================================
// Sampling
// =============================================================================

/// One head-sampling rule. At most ten may be attached to a drain, and they
/// are evaluated in order.
@formae.SubResourceHint {}
class DrainSampling extends formae.SubResource {
    /// Sampling strategy. Only head sampling is supported. Sent to the API as
    /// `type`.
    @formae.FieldHint { outputField = "type" }
    strategy: "head_sampling"

    /// Fraction of matching events to keep, from 0 to 1 — `0.1` keeps 10%.
    @formae.FieldHint {}
    rate: Float

    /// Restrict the rule to one deployment environment. Applies to every
    /// environment when unset.
    @formae.FieldHint {}
    env: ("production"|"preview")?

    /// Restrict the rule to requests whose path starts with this prefix.
    @formae.FieldHint {}
    requestPath: String?
}

// =============================================================================
// Filter
// =============================================================================

/// Project selector inside a basic drain filter.
@formae.SubResourceHint {}
class DrainProjectFilter extends formae.SubResource {
    /// Project ids to include.
    @formae.FieldHint { updateMethod = "Set" }
    ids: Listing<String>? = null
}

/// Log-source selector inside a basic drain filter. Ignored by drains that do
/// not carry the `log` schema.
@formae.SubResourceHint {}
class DrainLogFilter extends formae.SubResource {
    /// Log sources to forward.
    @formae.FieldHint { updateMethod = "Set" }
    sources: Listing<"build"|"edge"|"external"|"firewall"|"lambda"|"redirect"|"static">? = null
}

/// Deployment selector inside a basic drain filter.
@formae.SubResourceHint {}
class DrainDeploymentFilter extends formae.SubResource {
    /// Deployment environments to forward from.
    @formae.FieldHint { updateMethod = "Set" }
    environments: Listing<"production"|"preview">? = null
}

/// The filter body itself: either a structured `basic` selector or a raw
/// `odata` expression.
@formae.SubResourceHint {}
class DrainFilterSpec extends formae.SubResource {
    /// Which of the two filter forms this is. Sent to the API as `type`.
    @formae.FieldHint { outputField = "type" }
    kind: "basic"|"odata"

    /// `basic` only. Restrict to specific projects.
    @formae.FieldHint {}
    project: DrainProjectFilter?

    /// `basic` only. Restrict which log sources are forwarded.
    @formae.FieldHint {}
    log: DrainLogFilter?

    /// `basic` only. Restrict which deployment environments are forwarded.
    @formae.FieldHint {}
    deployment: DrainDeploymentFilter?

    /// `odata` only. The filter expression.
    @formae.FieldHint {}
    text: String?
}

/// A versioned drain filter.
@formae.SubResourceHint {}
class DrainFilter extends formae.SubResource {
    /// Filter grammar version. Currently `v2`.
    @formae.FieldHint {}
    version: String

    /// The filter itself.
    @formae.FieldHint {}
    filter: DrainFilterSpec
}

// =============================================================================
// Source
// =============================================================================

/// Provenance of a drain: created directly against the API, or owned by an
/// installed integration.
@formae.SubResourceHint {}
class DrainSource extends formae.SubResource {
    /// `self-served` for drains created with an access token — which is every
    /// drain formae creates. `integration` drains are owned by an installed
    /// integration and are not managed here.
    @formae.FieldHint {}
    kind: "self-served"|"integration"
}

// =============================================================================
// VERCEL::Drains::Drain
// =============================================================================

/// A Vercel Drain. Maps to `POST /v1/drains`.
///
/// One resource covers all three of the provider's drain kinds; `schemas`
/// decides which:
///
/// - **log drain** — `schemas { ["log"] { version = "v1" } }` with an `http`
///   delivery. Equivalent to `vercel_log_drain`.
/// - **trace drain** — `schemas { ["trace"] { version = "v1" } }` with an
///   `otlphttp` delivery. Equivalent to `vercel_trace_drain`.
/// - **audit log drain** — `schemas { ["audit_log"] { version = "v1" } }` with
///   an `http` or `s3` delivery. Equivalent to `vercel_audit_log_drain`.
///
/// Create, update and delete are synchronous.
///
/// Two properties are write-only, because the API accepts them but never
/// returns them: `projects` appears in no documented response, and `filter`
/// comes back under the different key `filterV2`. Both are excluded from drift
/// detection rather than reported as a permanent difference.
///
/// Not modelled, for the same round-trip reason in reverse: `status`
/// (`PATCH`-only, so it cannot be set at create time) and `transforms` (write
/// -only with no useful default). A drain is created enabled.
///
/// Caveat: `delivery` is a union of three classes, so formae records a hint for
/// `delivery` as a whole and not for its individual keys. A `secret` that
/// Vercel generates — rather than one the forma sets — can therefore show up as
/// drift on the next sync. Set `secret` explicitly to avoid it.
@formae.ResourceHint {
    type = "VERCEL::Drains::Drain"
    identifier = "$.id"
    discoverable = true
}
class Drain extends formae.Resource {
    fixed hidden type: String = "VERCEL::Drains::Drain"

    /// Human-readable drain name.
    @formae.FieldHint { requiredOnCreate = true }
    name: String

    /// Whether the drain covers every project (`all`) or only the ones listed
    /// in `projectIds` (`some`). Immutable: the API never returns it, so there
    /// is nothing an in-place update could reconcile against.
    @formae.FieldHint { createOnly = true; requiredOnCreate = true; writeOnly = true }
    projects: "some"|"all"

    /// Projects the drain covers when `projects` is `some`. Ignored when
    /// `projects` is `all`, which is why leaving it unset (it then renders as
    /// an empty list) is harmless.
    @formae.FieldHint { updateMethod = "Set" }
    projectIds: Listing<String|formae.Resolvable>? = null

    /// The data schemas this drain carries, keyed by schema name — `log`,
    /// `trace`, `audit_log`, `analytics`, `speed_insights`, `ai_gateway` or
    /// `connect`.
    ///
    /// Immutable: this is what makes a drain a log drain rather than a trace
    /// drain, and the official provider models each kind as its own resource.
    @formae.FieldHint { createOnly = true; requiredOnCreate = true }
    schemas: Mapping<String, DrainSchema>

    /// Where the drain ships its data. Pick the class matching the transport:
    /// `DrainHTTPDelivery`, `DrainOTLPDelivery` or `DrainS3Delivery`.
    @formae.FieldHint { requiredOnCreate = true }
    delivery: DrainHTTPDelivery|DrainOTLPDelivery|DrainS3Delivery

    /// Head-sampling rules, evaluated in order, at most ten. Unset renders as
    /// an empty list, which the API reads the same way: forward everything.
    @formae.FieldHint {}
    sampling: Listing<DrainSampling>? = null

    /// Which events reach the drain. Write-only: the API accepts `filter` on
    /// create and update but reports it back as `filterV2`, so it cannot be
    /// round-tripped and is excluded from drift detection.
    @formae.FieldHint { writeOnly = true }
    filter: DrainFilter? = null

    /// Provenance of the drain. Immutable, and `self-served` for anything
    /// formae creates.
    @formae.FieldHint { createOnly = true; writeOnly = true }
    source: DrainSource? = null
}
