/// Vercel REST API resource definitions.
///
/// Only resources implemented by the plugin appear here. See docs/RESOURCES.md
/// for the full catalog and the mapping to the official Terraform provider.
module vercel

import "@formae/formae.pkl"

// =============================================================================
// Target configuration
// =============================================================================

/// Deployment-level config for a Vercel target.
///
/// Credentials live in the environment (`VERCEL_TOKEN`, or `VERCEL_API_TOKEN`),
/// never in a forma.
open class Config {
    hidden fixed type: String = "vercel"

    /// Override the API base URL. Defaults to https://api.vercel.com.
    baseUrl: String? = null

    /// Team to act on behalf of, as a team id (`team_…`). Sent as `?teamId=`.
    /// Leave both `teamId` and `slug` unset to target the token's personal
    /// account.
    teamId: String? = null

    /// Team to act on behalf of, as a team slug. Sent as `?slug=`.
    /// Ignored when `teamId` is set.
    slug: String? = null

    /// Advanced / conformance-only. Scopes `List()` and discovery of
    /// environment variables to a single project. Leave unset in normal use —
    /// discovery then walks every project the token can see, which is slow on
    /// large accounts. Project discovery is always global regardless.
    projectId: String? = null

    fixed Type: String = type
    fixed BaseUrl: String? = baseUrl
    fixed TeamId: String? = teamId
    fixed Slug: String? = slug
    fixed ProjectId: String? = projectId
}

// =============================================================================
// VERCEL::Projects::Project
// =============================================================================

/// Resolvable handle for `VERCEL::Projects::Project` outputs. Reference these
/// from child resources to wire a freshly created project into its environment
/// variables in the same apply, e.g. `projectId = project.res.id`.
open class ProjectResolvable extends formae.Resolvable {
    hidden type = "VERCEL::Projects::Project"

    hidden id:   ProjectResolvable = (this) { property = "id" }
    hidden name: ProjectResolvable = (this) { property = "name" }
}

/// A Vercel project. Maps to `POST /v11/projects`.
///
/// Create/update/delete are synchronous — there is no provisioning wait.
/// An empty project (no Git repository, no deployment) costs nothing.
@formae.ResourceHint {
    type = "VERCEL::Projects::Project"
    identifier = "$.id"
    discoverable = true
}
class Project extends formae.Resource {
    fixed hidden type: String = "VERCEL::Projects::Project"

    local parent = this
    hidden res: ProjectResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }

    /// Project name. Lowercase alphanumerics and hyphens, max 100 characters.
    ///
    /// Immutable: `PATCH /v9/projects/{id}` does accept a new name, but a
    /// rename rewrites every generated deployment URL. The official Terraform
    /// provider marks it force-new for the same reason, and this plugin
    /// follows it.
    @formae.FieldHint {
        createOnly = true
        requiredOnCreate = true
    }
    name: String

    /// Framework preset, e.g. "nextjs", "vite", "astro", "svelte", "remix".
    /// Null lets Vercel auto-detect on the first deployment.
    @formae.FieldHint {}
    framework: String? = null

    /// Build command. Null means auto-detect. Max 256 characters.
    @formae.FieldHint {}
    buildCommand: String? = null

    /// Development command. Null means auto-detect. Max 256 characters.
    @formae.FieldHint {}
    devCommand: String? = null

    /// Install command. Null means auto-detect. Max 256 characters.
    @formae.FieldHint {}
    installCommand: String? = null

    /// Build output directory. Null means auto-detect. Max 256 characters.
    @formae.FieldHint {}
    outputDirectory: String? = null

    /// Directory within the repository that holds the project.
    /// Null means the repository root. Max 256 characters.
    @formae.FieldHint {}
    rootDirectory: String? = null

    /// Node.js runtime version, e.g. "22.x". Applied by update — the documented
    /// create body does not accept it, so a freshly created project keeps the
    /// account default until the first reconcile.
    @formae.FieldHint {}
    nodeVersion: String? = null
}

// =============================================================================
// VERCEL::Projects::EnvironmentVariable
// =============================================================================

/// Target environment for an environment variable.
typealias EnvironmentTarget = "production"|"preview"|"development"

/// Storage type for an environment variable's value.
///
/// - `plain`: stored and returned as-is.
/// - `encrypted`: encrypted at rest, still readable through the API.
/// - `sensitive`: write-only — Vercel never returns the value, so a
///   formae-managed `sensitive` variable reports drift on every sync.
/// - `system`: reserved for Vercel-provided values.
typealias EnvironmentVariableType = "plain"|"encrypted"|"sensitive"|"system"

/// Resolvable handle for `VERCEL::Projects::EnvironmentVariable` outputs.
open class EnvironmentVariableResolvable extends formae.Resolvable {
    hidden type = "VERCEL::Projects::EnvironmentVariable"

    hidden id:  EnvironmentVariableResolvable = (this) { property = "id" }
    hidden key: EnvironmentVariableResolvable = (this) { property = "key" }
}

/// An environment variable on a Vercel project.
/// Maps to `POST /v10/projects/{idOrName}/env`.
///
/// Native id is `{projectId}/{envId}`.
@formae.ResourceHint {
    type = "VERCEL::Projects::EnvironmentVariable"
    identifier = "$.id"
    parent = "VERCEL::Projects::Project"
    discoverable = true
}
class EnvironmentVariable extends formae.Resource {
    fixed hidden type: String = "VERCEL::Projects::EnvironmentVariable"

    local parent = this
    hidden res: EnvironmentVariableResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }

    /// Owning project id (`prj_…`) or project name. Immutable — the API has no
    /// move operation.
    @formae.FieldHint {
        createOnly = true
        requiredOnCreate = true
    }
    projectId: String|formae.Resolvable

    /// Variable name. Letters, digits and `_` only, max 256 characters.
    @formae.FieldHint { requiredOnCreate = true }
    key: String

    /// Variable value, max 65536 characters. Accepts a `formae.Value` so it can
    /// be a formae-managed secret; formae resolves it to a plain string before
    /// the plugin sees it.
    @formae.FieldHint { requiredOnCreate = true }
    value: (formae.Value|String)

    /// Storage type. Named `variableType` rather than `type` because
    /// `formae.Resource` already reserves `type`. Defaults to `encrypted`,
    /// matching the Vercel dashboard.
    @formae.FieldHint {}
    variableType: EnvironmentVariableType = "encrypted"

    /// Environments the variable applies to. Named `targets` rather than
    /// `target` (the API's name) because `formae.Resource` already reserves
    /// `target` for the deployment target. One of `targets` or
    /// `customEnvironmentIds` is required.
    @formae.FieldHint { updateMethod = "Set" }
    targets: Listing<EnvironmentTarget>?

    /// Custom environment ids the variable applies to. Alternative to
    /// `targets`.
    @formae.FieldHint { updateMethod = "Set" }
    customEnvironmentIds: Listing<String>?

    /// Git branch the variable is scoped to. Only valid together with
    /// `targets` containing "preview". Max 250 characters.
    @formae.FieldHint {}
    gitBranch: String? = null

    /// Free-text note explaining what the variable is for. Max 500 characters.
    @formae.FieldHint {}
    comment: String? = null
}

// =============================================================================
// VERCEL::Projects::CustomEnvironment
// =============================================================================

/// How a custom environment picks up git branches.
@formae.SubResourceHint {}
class BranchMatcher extends formae.SubResource {
    /// One of "equals", "startsWith", "endsWith".
    @formae.FieldHint {}
    type: "equals"|"startsWith"|"endsWith"

    /// Git branch name, or the portion of it to match.
    @formae.FieldHint {}
    pattern: String
}

/// A custom deployment environment on a project.
/// Maps to `POST /v9/projects/{idOrName}/custom-environments`.
///
/// Note the wire name is `slug`, not `name`, and it cannot be "production" or
/// "preview".
@formae.ResourceHint {
    type = "VERCEL::Projects::CustomEnvironment"
    identifier = "$.id"
    parent = "VERCEL::Projects::Project"
    discoverable = true
}
class CustomEnvironment extends formae.Resource {
    fixed hidden type: String = "VERCEL::Projects::CustomEnvironment"

    /// Owning project id or name. Immutable.
    @formae.FieldHint { createOnly = true; requiredOnCreate = true }
    projectId: String|formae.Resolvable

    /// URL-friendly environment name, max 32 characters. Immutable.
    @formae.FieldHint { createOnly = true; requiredOnCreate = true }
    slug: String

    /// Optional description, max 256 characters.
    @formae.FieldHint {}
    description: String? = null

    /// Optional branch-matching rule for automatic deployments.
    @formae.FieldHint {}
    branchMatcher: BranchMatcher? = null

    /// Environment to seed environment variables from, applied only at
    /// creation time.
    @formae.FieldHint { createOnly = true }
    copyEnvVarsFrom: String? = null
}

// =============================================================================
// VERCEL::Projects::Domain
// =============================================================================

/// A domain attached to a project.
/// Maps to `POST /v10/projects/{idOrName}/domains`.
///
/// Keyed by the domain name itself. Adding a custom domain requires a paid
/// plan; on Hobby the API answers `custom_domain_needs_upgrade`.
@formae.ResourceHint {
    type = "VERCEL::Projects::Domain"
    identifier = "$.id"
    parent = "VERCEL::Projects::Project"
    discoverable = true
}
class ProjectDomain extends formae.Resource {
    fixed hidden type: String = "VERCEL::Projects::Domain"

    /// Owning project id or name. Immutable.
    @formae.FieldHint { createOnly = true; requiredOnCreate = true }
    projectId: String|formae.Resolvable

    /// The domain name. Immutable — it is the resource's identity.
    @formae.FieldHint { createOnly = true; requiredOnCreate = true }
    name: String

    /// Git branch to bind the domain to. Mutually exclusive with `redirect`.
    @formae.FieldHint {}
    gitBranch: String? = null

    /// Custom environment to bind the domain to.
    @formae.FieldHint {}
    customEnvironmentId: String? = null

    /// Redirect target domain. Mutually exclusive with `gitBranch`.
    @formae.FieldHint {}
    redirect: String? = null

    /// HTTP status used for the redirect.
    @formae.FieldHint {}
    redirectStatusCode: Int(this == 301 || this == 302 || this == 307 || this == 308)? = null
}

// =============================================================================
// VERCEL::DNS::Record
// =============================================================================

/// SRV record payload.
@formae.SubResourceHint {}
class SRVRecord extends formae.SubResource {
    @formae.FieldHint {}
    priority: Int

    @formae.FieldHint {}
    weight: Int

    @formae.FieldHint {}
    port: Int

    @formae.FieldHint {}
    target: String
}

/// A DNS record on a domain Vercel manages.
/// Maps to `POST /v2/domains/{domain}/records`.
///
/// The API spells the record type `type`, which `formae.Resource` reserves, so
/// it is declared here as `recordType` and renamed on the wire.
@formae.ResourceHint {
    type = "VERCEL::DNS::Record"
    identifier = "$.id"
    discoverable = true
}
class DNSRecord extends formae.Resource {
    fixed hidden type: String = "VERCEL::DNS::Record"

    /// Domain the record belongs to. Immutable.
    @formae.FieldHint { createOnly = true; requiredOnCreate = true }
    domain: String

    /// Subdomain, or an empty string for the apex. Immutable.
    @formae.FieldHint { createOnly = true; requiredOnCreate = true }
    name: String

    /// Record type. Immutable.
    @formae.FieldHint { createOnly = true; requiredOnCreate = true }
    recordType: "A"|"AAAA"|"ALIAS"|"CAA"|"CNAME"|"HTTPS"|"MX"|"NS"|"SRV"|"TXT"

    /// Record value. Required for every type except SRV, which uses `srv`.
    @formae.FieldHint {}
    value: String? = null

    /// Time to live in seconds, 60 to 2147483647.
    @formae.FieldHint {}
    ttl: Int? = null

    /// Priority, for MX records.
    @formae.FieldHint {}
    mxPriority: Int? = null

    /// SRV payload, for SRV records.
    @formae.FieldHint {}
    srv: SRVRecord? = null

    /// Free-text note, max 500 characters.
    @formae.FieldHint {}
    comment: String? = null
}

// =============================================================================
// VERCEL::GlobalConfig::Config
// =============================================================================

/// A Global Config store (the API's new name for Edge Config).
/// Maps to `POST /v1/global-config`.
///
/// Only `slug` is durable state and it is immutable, so any change replaces the
/// store. The items inside it are not modelled: the API writes the whole set in
/// one batch PATCH, and writes are billed per thousand.
@formae.ResourceHint {
    type = "VERCEL::GlobalConfig::Config"
    identifier = "$.id"
    discoverable = true
}
class GlobalConfig extends formae.Resource {
    fixed hidden type: String = "VERCEL::GlobalConfig::Config"

    /// Store name. Word characters only, max 64. Immutable.
    @formae.FieldHint { createOnly = true; requiredOnCreate = true }
    slug: String
}

// =============================================================================
// VERCEL::Webhooks::Webhook
// =============================================================================

/// An account or team webhook. Maps to `POST /v1/webhooks`.
///
/// The API has no update endpoint, so every field is immutable and any change
/// replaces the webhook. The signing secret is returned only on creation.
@formae.ResourceHint {
    type = "VERCEL::Webhooks::Webhook"
    identifier = "$.id"
    discoverable = true
}
class Webhook extends formae.Resource {
    fixed hidden type: String = "VERCEL::Webhooks::Webhook"

    /// Destination URL. Must be http(s). Immutable.
    @formae.FieldHint { createOnly = true; requiredOnCreate = true }
    url: String

    /// Events to subscribe to, e.g. "deployment.succeeded", "project.created".
    /// Immutable.
    @formae.FieldHint { createOnly = true; requiredOnCreate = true; updateMethod = "Set" }
    events: Listing<String>

    /// Restrict the webhook to specific projects. Immutable.
    @formae.FieldHint { createOnly = true; updateMethod = "Set" }
    projectIds: Listing<String>?
}

// =============================================================================
// VERCEL::Networking::Network
// =============================================================================

/// A Secure Compute network. Maps to `POST /v1/connect/networks`.
///
/// Caveat: creation is asynchronous — the network reports
/// `create_in_progress` before it becomes `ready`, and the plugin currently
/// returns success as soon as the API accepts the request.
@formae.ResourceHint {
    type = "VERCEL::Networking::Network"
    identifier = "$.id"
    discoverable = true
}
class Network extends formae.Resource {
    fixed hidden type: String = "VERCEL::Networking::Network"

    /// Network name, max 255 characters.
    @formae.FieldHint { requiredOnCreate = true }
    name: String

    /// CIDR block of the network. Immutable.
    @formae.FieldHint { createOnly = true; requiredOnCreate = true }
    cidr: String

    /// Vercel region the network lives in. Immutable.
    @formae.FieldHint { createOnly = true; requiredOnCreate = true }
    region: String

    /// AWS availability zone ids to pin the network to. Immutable.
    @formae.FieldHint { createOnly = true; updateMethod = "Set" }
    awsAvailabilityZoneIds: Listing<String>?
}
