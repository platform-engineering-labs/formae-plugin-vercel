//
// Conformance test — rename an access group (the API updates via POST).
// See accessgroup.pkl for the token scope that blocks this today.

amends "@formae/forma.pkl"
import "@vercel/core/vercel.pkl"

import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  new vercel.AccessGroup {
    label = "plugin-sdk-test-accessgroup"
    name = "\(v.prefix)-\(v.shortID)-upd"   // CHANGED
  }
}
