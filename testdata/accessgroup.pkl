//
// Conformance test — VERCEL::AccessGroups::AccessGroup.
//
// KNOWN TO FAIL with a token that lacks access-group scope. Verified
// 2026-08-13:
//   Create -> 403 forbidden: "You don't have permission to create the access
//   group."
// Environmental, not a plugin defect. Kept so the gap stays visible.

amends "@formae/forma.pkl"
import "@vercel/core/vercel.pkl"

import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  new vercel.AccessGroup {
    label = "plugin-sdk-test-accessgroup"
    // Allowed: letters, digits, spaces, underscore, hyphen. Max 50.
    name = "\(v.prefix)-\(v.shortID)"
  }
}
