//
// Conformance test — VERCEL::Auth::Token.
//
// Creates a REAL account API token and destroys it again. The token value is
// returned once at creation and is deliberately not modelled as state, so
// nothing secret is stored or logged. The API has no update endpoint.
//
// KNOWN TO FAIL with a team-scoped token. Verified 2026-08-13:
//   Create -> 403 forbidden: "To create a token you must be authenticated to
//   scope <account>"
// A team-scoped token cannot mint user tokens. Environmental, not a defect.

amends "@formae/forma.pkl"
import "@vercel/core/vercel.pkl"

import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  new vercel.AuthToken {
    label = "plugin-sdk-test-authtoken"
    name = "\(v.prefix)-\(v.shortID)"
  }
}
