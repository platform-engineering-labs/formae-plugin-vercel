//
// Conformance test — VERCEL::Projects::CustomEnvironment.
//
// KNOWN TO FAIL on accounts without the feature. Verified 2026-08-13:
//   Create -> 400 bad_request: "Cannot create more than 0 custom environments."
// That is a plan limit, not a plugin defect — the 400 is mapped correctly to
// InvalidRequest. Kept so the gap stays visible; it should pass on a plan that
// includes custom environments.

amends "@formae/forma.pkl"
import "@vercel/core/vercel.pkl"

import "./config/vars.pkl" as v

local project = new vercel.Project {
  label = "plugin-sdk-test-customenv-project"
  name = "\(v.prefix)-customenv-\(v.testRunID)"
}

forma {
  v.stack
  v.target

  project

  new vercel.CustomEnvironment {
    label = "plugin-sdk-test-customenv"
    projectId = project.res.id
    // The API caps a slug at 32 characters, hence the short run id.
    slug = "sdk-\(v.shortID)"
    description = "Plugin SDK conformance test environment"
  }
}
