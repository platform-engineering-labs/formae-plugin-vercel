//
// Conformance test — in-place update of VERCEL::Projects::EnvironmentVariable.
// `projectId` is unchanged (createOnly); value, targets and comment PATCH.

amends "@formae/forma.pkl"
import "@vercel/core/vercel.pkl"

import "./config/vars.pkl" as v

local project = new vercel.Project {
  label = "plugin-sdk-test-envvar-project"
  name = "\(v.prefix)-envvar-\(v.testRunID)"
}

forma {
  v.stack
  v.target

  project

  new vercel.EnvironmentVariable {
    label = "plugin-sdk-test-envvar"
    projectId = project.res.id
    key = "FORMAE_SDK_TEST"
    value = "updated-\(v.testRunID)"                 // CHANGED
    variableType = "plain"
    targets = new Listing { "production" }           // CHANGED (preview removed)
    comment = "Plugin SDK conformance — updated"     // CHANGED
  }
}
