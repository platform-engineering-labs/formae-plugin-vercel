//
// Conformance test — VERCEL::GlobalConfig::Config (Edge Config).
//
// Creating a store is free. Writing *items* is metered, and items are not
// modelled by this plugin, so this test only exercises the store itself.
// `slug` is the only field and it is immutable, so there is no update variant.

amends "@formae/forma.pkl"
import "@vercel/core/vercel.pkl"

import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  new vercel.GlobalConfig {
    label = "plugin-sdk-test-globalconfig"
    // Slug allows word characters and hyphens, max 64.
    slug = "\(v.prefix)-\(v.testRunID)"
  }
}
