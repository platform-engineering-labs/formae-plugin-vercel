//
// Conformance test — in-place update of VERCEL::Projects::Project.
// `name` is unchanged (createOnly); everything below it is PATCHable.

amends "@formae/forma.pkl"
import "@vercel/core/vercel.pkl"

import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  new vercel.Project {
    label = "plugin-sdk-test-project"
    name = "\(v.prefix)-project-\(v.testRunID)"   // unchanged (createOnly)
    framework = "vite"                            // CHANGED
    buildCommand = "npm run build:prod"           // CHANGED
    outputDirectory = "dist"                      // CHANGED
    installCommand = "npm ci"                     // ADDED
  }
}
