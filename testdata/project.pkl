//
// Conformance test — create VERCEL::Projects::Project.
//
// An empty project (no Git repository, no deployment) is free and provisions
// synchronously, which makes it a cheap resource to churn.

amends "@formae/forma.pkl"
import "@vercel/core/vercel.pkl"

import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  new vercel.Project {
    label = "plugin-sdk-test-project"
    name = "\(v.prefix)-project-\(v.testRunID)"
    framework = "nextjs"
    buildCommand = "npm run build"
    outputDirectory = ".next"
  }
}
