//
// Conformance test — VERCEL::Projects::Domain.
//
// Attaches a subdomain of the account's apex domain to a throwaway project.
// A subdomain rather than the apex, so the fixture cannot interfere with
// whatever the apex actually serves; detaching leaves the domain itself in the
// account, since this resource is the project↔domain association and not the
// domain.

amends "@formae/forma.pkl"
import "@vercel/core/vercel.pkl"

import "./config/vars.pkl" as v

local project = new vercel.Project {
  label = "plugin-sdk-test-projectdomain-project"
  name = "\(v.prefix)-pdomain-\(v.testRunID)"
}

forma {
  v.stack
  v.target

  project

  new vercel.ProjectDomain {
    label = "plugin-sdk-test-projectdomain"
    projectId = project.res.id
    name = "sdk-\(v.shortID).\(v.testDomain)"
  }
}
