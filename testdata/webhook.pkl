//
// Conformance test — VERCEL::Webhooks::Webhook.
//
// The API has no update endpoint, so every field is createOnly and there is no
// update variant. The endpoint below is never called by the test; Vercel only
// delivers to it if a matching event fires.

amends "@formae/forma.pkl"
import "@vercel/core/vercel.pkl"

import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  new vercel.Webhook {
    label = "plugin-sdk-test-webhook"
    url = "https://example.com/formae-sdk-test/\(v.testRunID)"
    events = new Listing { "deployment.succeeded" }
  }
}
